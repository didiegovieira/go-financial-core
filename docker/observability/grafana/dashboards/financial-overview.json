{
  "uid": "financial-overview",
  "title": "Financial Core - Logs, Metrics & Traces",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "financial-core",
    "mvp"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests since process start",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(financial_http_requests_total{service_name=~\"${service:pipe}\",route=~\"${http_route:regex}\",method=~\"${http_method:regex}\",status=~\"${http_status:regex}\"})",
          "legendFormat": "{{service_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Servico filtra este painel. Filtros HTTP/Kafka afetam suas respectivas metricas; nivel, texto e Trace ID afetam somente logs."
    },
